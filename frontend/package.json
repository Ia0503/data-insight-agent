{
  "name": "newai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts tsconfig.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vue-tsc": "3.3.12"
  }
}
