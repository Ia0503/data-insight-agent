POSTGRES_DB=newai
POSTGRES_USER=newai
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://newai:YOUR_DATABASE_PASSWORD_HERE@127.0.0.1:55432/newai
TEST_DATABASE_URL=postgresql+psycopg://newai:YOUR_DATABASE_PASSWORD_HERE@127.0.0.1:55432/newai_test
UPLOAD_DIR=runtime/uploads
MAX_UPLOAD_MB=20
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65
EMBEDDING_DIR=runtime/models/bge-base-zh-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_POOLING=cls
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_MAX_TOKENS=512
EMBEDDING_TIMEOUT_SECONDS=60
CHUNK_TOKENS=300
CHUNK_OVERLAP=40

# ============================================================================
# 【生成式模型配置待填写】以下项目有意留空。
# 只在本地 .env 填写真实信息，不要把密钥写进此模板或提交到 Git。
# 先选平台，再填该平台的 BASE_URL、MODEL、API_KEY；其余平台保持空白。
# 可选平台：aliyun / deepseek / siliconflow / volcengine / zhipu / moonshot / custom
# 【待填写：默认使用的平台】
LLM_PROVIDER=
# 【保持 false：你填写配置并确认真实联调时再开启；避免意外计费】
LLM_CALLS_ENABLED=false
# 初期关闭思考模式；百炼/DeepSeek 的开启参数由各自适配器处理
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=300

# 调用保护：运行 backend/setup_access.py 交互配置，仅保存加盐哈希。
ANALYSIS_PASSWORD_REQUIRED=true
ANALYSIS_PASSWORD_HASH=
# 全站网页分析输入+输出 Tokens，按中国标准时间自然小时计数。
LLM_HOURLY_TOKEN_LIMIT=1000000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Compose 默认仅本机访问；公网入口须先配置 HTTPS 与数据访问范围。
WEB_BIND=127.0.0.1
WEB_PORT=8080

# >>> 【待填写：阿里云百炼，使用自己的地域/工作空间接口地址】 >>>
LLM_ALIYUN_BASE_URL=
LLM_ALIYUN_MODEL=
LLM_ALIYUN_API_KEY=

# >>> 【待填写：DeepSeek 官方，MODEL 填实际模型 ID，不能只填 ds v4】 >>>
LLM_DEEPSEEK_BASE_URL=
LLM_DEEPSEEK_MODEL=
LLM_DEEPSEEK_API_KEY=

# >>> 【可选待填写：硅基流动】 >>>
LLM_SILICONFLOW_BASE_URL=
LLM_SILICONFLOW_MODEL=
LLM_SILICONFLOW_API_KEY=

# >>> 【可选待填写：火山方舟，使用普通模型 API 配置】 >>>
LLM_VOLCENGINE_BASE_URL=
LLM_VOLCENGINE_MODEL=
LLM_VOLCENGINE_API_KEY=

# >>> 【可选待填写：智谱 BigModel，使用普通模型 API 配置】 >>>
LLM_ZHIPU_BASE_URL=
LLM_ZHIPU_MODEL=
LLM_ZHIPU_API_KEY=

# >>> 【可选待填写：Moonshot / Kimi】 >>>
LLM_MOONSHOT_BASE_URL=
LLM_MOONSHOT_MODEL=
LLM_MOONSHOT_API_KEY=

# >>> 【可选待填写：自定义 Chat Completions 兼容接口】 >>>
